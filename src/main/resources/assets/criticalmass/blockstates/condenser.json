{
 "multipart": [
  {
   "when": {
    "facing": "north|south"
   },
   "apply": {
    "model": "criticalmass:block/condenser"
   }
  },
  {
   "when": {
    "facing": "east|west"
   },
   "apply": {
    "model": "criticalmass:block/condenser",
    "y": 90
   }
  },
  {
   "when": {
    "up": "true"
   },
   "apply": {
    "model": "criticalmass:block/relief_valve/stub",
    "x": 270
   }
  },
  {
   "when": {
    "down": "true"
   },
   "apply": {
    "model": "criticalmass:block/relief_valve/stub",
    "x": 90
   }
  }
 ]
}
